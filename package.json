{
  "name": "playwright-ecommerce-automation",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end e-commerce automation with Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  }
}
